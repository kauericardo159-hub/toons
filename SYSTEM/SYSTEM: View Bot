-- Busca o Emoji Exclusivo (case-insensitive)
local function getBotEmoji(name)
    local nameLower = string.lower(name)
    for key, emoji in pairs(MONSTER_EMOJIS) do
        if string.find(nameLower, string.lower(key)) then
            return emoji
        end
    end
    return "👾"
end

-- ==========================================
-- LÓGICA DE DETECÇÃO (NOME + HUMANOID)
-- ==========================================
local function isBot(obj)
    if not obj or not obj.Parent then return false end
    if Players:GetPlayerFromCharacter(obj) or obj == localPlayer.Character then return false end
    
    local nameLower = string.lower(obj.Name)
    
    -- 1. Bloqueia estritamente itens falsos (Câmeras, Barreiras, etc.)
    for _, ignored in ipairs(IGNORED_NAMES) do
        if string.find(nameLower, ignored) then return false end
    end
    
    -- 2. Checagem por Nome Mapeado na Lista
    for monsterKey, _ in pairs(MONSTER_EMOJIS) do
        if string.find(nameLower, string.lower(monsterKey)) then
            return true
        end
    end
    
    -- 3. Detecção Reforçada por Humanoid (Para entidades vivas sem nome na lista)
    if obj:IsA("Model") then
        local hum = obj:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            -- Garante que não é elemento invencível ou estático do cenário
            if hum.WalkSpeed > 0 or hum.MaxHealth < 99999 then
                return true
            end
        end
    end
    
    return false
end

local function checkAndAddEntity(obj)
    if not _G.SystemViewBotActive then return end
    
    -- Se for um Model ou Part válida que atenda aos critérios
    if (obj:IsA("Model") or obj:IsA("BasePart")) and not botCache[obj] then
        if isBot(obj) then
            botCache[obj] = createVisuals(obj)
        end
    end
end

