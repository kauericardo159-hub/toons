-- ==========================================
-- CONFIGURAÇÕES VISUAIS & DISTÂNCIA
-- ==========================================
local MAX_DISTANCE = 600
local FADE_START = 450

-- Cores do Tema Toons Universe
local OUTLINE_COLOR = Color3.fromRGB(255, 120, 220) -- Rosa Magenta
local BOT_NAME_COLOR = "#FFD264"                     -- Amarelo Pastel
local BOT_STROKE_COLOR = Color3.fromRGB(20, 15, 45)  -- Roxo Escuro Contorno
local DIST_COLOR = "#78C8FF"                         -- Azul Pastel
local HP_COLOR = "#FF6496"                           -- Rosa Pastel

-- 📜 LISTA DE INIMIGOS E TENTÁCULOS
local MONSTER_NAMES = {
    -- Nomes Específicos com/sem Prefixo T
    "tteipo", "tsquiddle", "tselena", "tpatcher",
    "tkoi", "tg&r", "tfizzle", "tdiscard",
    "tcopper", "tphantasia",
    "teipo", "squiddle", "selena", "patcher",
    "koi", "g&r", "fizzle", "discard",
    "copper", "phantasia",

    -- Tentáculos (Adicionado em inglês)
    "tentacle", "tentacles", "tentacled", "arm", "limb",

    -- Nomes Genéricos de Inimigos/Monstros
    "monster", "infected", "chaser", "enemy", "bot", "killer", "boss"
}

-- ⛔ FILTRO ANTI-FALSOS POSITIVOS (E elementos de cenário/mapa)
local IGNORED_TERMS = {
    "npc", "vendor", "shop", "merchant", "dummy", "guide", "trader",
    "spawn", "door", "wall", "floor", "map", "checkpoint", "light",
    "part", "folder", "camera", "desk", "table", "chair", "item"
}

