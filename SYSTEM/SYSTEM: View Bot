-- Retorna o emoji exclusivo correspondente ao nome do monstro
local function getBotEmoji(name)
    local nameLower = string.lower(name)
    for key, emoji in pairs(MONSTER_EMOJIS) do
        if string.find(nameLower, key) then
            return emoji
        end
    end
    return "👾" -- Emoji padrão se não estiver mapeado
end

local function isBot(obj)
    if not obj or not obj.Parent then return false end
    if Players:GetPlayerFromCharacter(obj) or obj == localPlayer.Character then return false end
    
    local nameLower = string.lower(obj.Name)
    
    -- 1. Bloqueia rigorosamente falsos positivos (Ex: HumanoidCameraRig, MonsterBarrier)
    for _, ignored in ipairs(IGNORED_NAMES) do
        if string.find(nameLower, ignored) then return false end
    end
    
    -- 2. Detecta se o nome está na lista com/sem T ou tentáculos/cobra
    for monsterKey, _ in pairs(MONSTER_EMOJIS) do
        if string.find(nameLower, monsterKey) then
            return true
        end
    end
    
    return false
end

local function checkAndAddEntity(obj)
    if not _G.SystemViewBotActive then return end
    if (obj:IsA("Model") or obj:IsA("BasePart")) and not botCache[obj] then
        if isBot(obj) then
            botCache[obj] = createVisuals(obj)
        end
    end
end

