-- ==========================================
-- CONFIGURAÇÕES VISUAIS
-- ==========================================
local MAX_DISTANCE = 650
local FADE_START = 500

local OUTLINE_COLOR = Color3.fromRGB(255, 120, 220) -- Rosa Magenta
local BOT_NAME_COLOR = "#FFD264"                     -- Amarelo Pastel
local BOT_STROKE_COLOR = Color3.fromRGB(20, 15, 45)  -- Roxo Escuro Contorno
local DIST_COLOR = "#78C8FF"                         -- Azul Pastel
local HP_COLOR = "#FF6496"                           -- Rosa Pastel

-- 📜 LISTA DE INIMIGOS, COBRAS E ENTIDADES DO TETO/BURACO
local MONSTER_NAMES = {
    -- Infectados principais da loja/jogo
    "teipo", "squiddle", "selena", "patcher",
    "koi", "g&r", "fizzle", "discard",
    "copper", "phantasia", "nimbus",

    -- Inimigos de buraco/teto (Cobra e variações)
    "snake", "serpent", "hole", "ceiling", "vent",
    "tentacle", "tentacles", "tentacled", "arm", "limb",

    -- Outras entidades hostis do jogo
    "infected", "chaser", "killer", "monster", "bot", "enemy"
}

-- ⛔ BLOQUEIO COMPLETO E IMPEDIMENTO DE FALSOS POSITIVOS
local IGNORED_TERMS = {
    "humanoidcamerarig", "camerarig", "camera", "monsterbarrier", "barrier", "rig",
    "npc", "vendor", "shop", "merchant", "dummy", "guide", "trader",
    "spawn", "door", "wall", "floor", "map", "checkpoint", "light",
    "desk", "table", "chair", "item", "part", "folder", "value"
}

_G.SystemViewBotFolder = Instance.new("Folder")
_G.SystemViewBotFolder.Name = "ViewBotCache_Toons"
_G.SystemViewBotFolder.Parent = localPlayer:WaitForChild("PlayerGui")

_G.BotCacheViewBot = {}
local botCache = _G.BotCacheViewBot

-- ==========================================
-- ESTRUTURA VISUAL DA ESP
-- ==========================================
local function createVisuals(entity)
    local data = {}
    
    local hl = Instance.new("Highlight")
    hl.Name = "BotOutline"
    hl.FillColor = Color3.fromRGB(255, 120, 220)
    hl.FillTransparency = 0.8
    hl.OutlineColor = OUTLINE_COLOR
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    local bg = Instance.new("BillboardGui")
    bg.Name = "BotInfo"
    bg.Size = UDim2.new(0, 240, 0, 55)
    bg.StudsOffset = Vector3.new(0, 3.5, 0)
    bg.AlwaysOnTop = true
    bg.LightInfluence = 0
    bg.Parent = _G.SystemViewBotFolder
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.FredokaOne
    nameLabel.TextSize = 16
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = BOT_STROKE_COLOR
    nameLabel.RichText = true
    nameLabel.Parent = bg
    
    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, 0, 0.5, 0)
    statsLabel.Position = UDim2.new(0, 0, 0.5, 0)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Font = Enum.Font.FredokaOne
    statsLabel.TextSize = 14
    statsLabel.TextStrokeTransparency = 0.1
    statsLabel.TextStrokeColor3 = BOT_STROKE_COLOR
    statsLabel.RichText = true
    statsLabel.Parent = bg
    
    data.Highlight = hl
    data.UI = bg
    data.NameLabel = nameLabel
    data.StatsLabel = statsLabel
    
    return data
end

-- ==========================================
-- LÓGICA DE DETECÇÃO FILTRADA
-- ==========================================
local function isBot(obj)
    if not obj or not obj.Parent then return false end
    
    -- Ignora o jogador local e outros players reais
    if Players:GetPlayerFromCharacter(obj) or obj == localPlayer.Character then return false end
    
    local nameLower = string.lower(obj.Name)
    
    -- PASSO 1: Bloqueia IMEDIATAMENTE qualquer falsos positivos (Câmera, Barreira, etc.)
    for _, ignored in ipairs(IGNORED_TERMS) do
        if string.find(nameLower, ignored) then 
            return false 
        end
    end

    -- PASSO 2: Aceita se o nome for de um monstro, infectado, cobra ou tentáculo
    for _, monster in ipairs(MONSTER_NAMES) do
        if string.find(nameLower, monster) then
            return true
        end
    end

    return false
end

local function checkAndAddEntity(obj)
    if not _G.SystemViewBotActive then return end
    if not botCache[obj] and isBot(obj) then
        botCache[obj] = createVisuals(obj)
    end
end

-- ==========================================
-- MONITORAMENTO E VARREDURA DO MAPA
-- ==========================================
task.spawn(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not _G.SystemViewBotActive then break end
        checkAndAddEntity(obj)
    end
end)

_G.SystemViewBotAddedConn = workspace.DescendantAdded:Connect(function(descendant)
    if not _G.SystemViewBotActive then return end
    
    task.delay(0.15, function()
        if descendant and descendant.Parent then
            checkAndAddEntity(descendant)
        end
    end)
end)

-- ==========================================
-- LOOP DE RENDERIZAÇÃO
-- ==========================================
_G.SystemViewBotConnection = RunService.RenderStepped:Connect(function()
    local myChar = localPlayer.Character
    local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    
    if not myHRP then return end

    for botEntity, vis in pairs(botCache) do
        if not botEntity or not botEntity.Parent then
            vis.Highlight:Destroy()
            vis.UI:Destroy()
            botCache[botEntity] = nil
            continue
        end

        local targetPart = botEntity:IsA("BasePart") and botEntity
            or botEntity:FindFirstChild("Head") 
            or botEntity:FindFirstChild("HumanoidRootPart") 
            or botEntity.PrimaryPart 
            or botEntity:FindFirstChildWhichIsA("BasePart")
            
        local hum = botEntity:FindFirstChildOfClass("Humanoid")
        
        if targetPart then
            local dist = (myHRP.Position - targetPart.Position).Magnitude
            
            if dist <= MAX_DISTANCE then
                local fade = math.clamp((dist - FADE_START) / (MAX_DISTANCE - FADE_START), 0, 1)
                
                vis.Highlight.Parent = botEntity
                vis.Highlight.OutlineTransparency = fade
                
                vis.UI.Adornee = targetPart
                vis.UI.Enabled = true
                
                vis.NameLabel.TextStrokeTransparency = fade
                vis.StatsLabel.TextStrokeTransparency = fade
                vis.NameLabel.TextTransparency = fade
                vis.StatsLabel.TextTransparency = fade
                
                local hpText = hum and math.floor(hum.Health) or "100"
                
                vis.NameLabel.Text = string.format('<font color="%s">👾 %s</font>', BOT_NAME_COLOR, botEntity.Name)
                vis.StatsLabel.Text = string.format('<font color="%s">📍 %dm</font>  |  <font color="%s">💖 %s</font>', DIST_COLOR, math.floor(dist), HP_COLOR, tostring(hpText))
            else
                vis.Highlight.Parent = nil
                vis.UI.Enabled = false
            end
        else
            vis.Highlight.Parent = nil
            vis.UI.Enabled = false
        end
    end
end)
