-- ==========================================
-- ESTRUTURA VISUAL DA HIGHLIGHT E TEXTO
-- ==========================================
local function createVisuals()
    local data = {}
    
    local hl = Instance.new("Highlight")
    hl.Name = "BotOutline"
    hl.FillColor = Color3.fromRGB(255, 120, 220)
    hl.FillTransparency = 0.8
    hl.OutlineColor = OUTLINE_COLOR
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    local bg = Instance.new("BillboardGui")
    bg.Name = "BotInfo"
    bg.Size = UDim2.new(0, 240, 0, 55)
    bg.StudsOffset = Vector3.new(0, 3.5, 0)
    bg.AlwaysOnTop = true
    bg.LightInfluence = 0
    bg.Parent = _G.SystemViewBotFolder
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.FredokaOne
    nameLabel.TextSize = 16
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = BOT_STROKE_COLOR
    nameLabel.RichText = true
    nameLabel.Parent = bg
    
    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, 0, 0.5, 0)
    statsLabel.Position = UDim2.new(0, 0, 0.5, 0)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Font = Enum.Font.FredokaOne
    statsLabel.TextSize = 14
    statsLabel.TextStrokeTransparency = 0.1
    statsLabel.TextStrokeColor3 = BOT_STROKE_COLOR
    statsLabel.RichText = true
    statsLabel.Parent = bg
    
    data.Highlight = hl
    data.UI = bg
    data.NameLabel = nameLabel
    data.StatsLabel = statsLabel
    
    return data
end

-- ==========================================
-- TRATAMENTO DE NOME
-- ==========================================
local function getFormattedName(obj)
    local nameLower = string.lower(obj.Name)
    
    -- Busca no dicionário direto
    if NAME_MAP[nameLower] then
        return NAME_MAP[nameLower]
    end
    
    -- Se o nome começar com 'T' e não estiver no mapa, remove o 'T'
    if string.sub(nameLower, 1, 1) == "t" and #nameLower > 2 then
        local clean = string.sub(obj.Name, 2)
        return clean:sub(1,1):upper() .. clean:sub(2)
    end
    
    return obj.Name
end

local function checkAndAddEntity(obj)
    if not _G.SystemViewBotActive or botCache[obj] then return end
    
    -- Evita marcar a pasta 'MonsterFolder' ou pastas organizadoras como 'TSnakes'
    if obj:IsA("Folder") or obj:IsA("Configuration") then return end
    
    -- Aceita Models ou Partes físicas reais dentro da estrutura de monstros
    if obj:IsA("Model") or obj:IsA("BasePart") then
        local data = createVisuals()
        data.CleanName = getFormattedName(obj)
        botCache[obj] = data
    end
end

-- ==========================================
-- THREAD 1: MONITORAMENTO DA MONSTERFOLDER
-- ==========================================
local monsterFolder = Workspace:FindFirstChild("MonsterFolder") or Workspace

task.spawn(function()
    -- Varre a MonsterFolder especificamente (ou Workspace caso ela não exista)
    for _, obj in ipairs(monsterFolder:GetDescendants()) do
        if not _G.SystemViewBotActive then break end
        checkAndAddEntity(obj)
    end
end)

_G.SystemViewBotAddedConn = monsterFolder.DescendantAdded:Connect(function(descendant)
    if not _G.SystemViewBotActive then return end
    
    task.delay(0.1, function()
        if descendant and descendant.Parent then
            checkAndAddEntity(descendant)
        end
    end)
end)

-- ==========================================
-- THREAD 2: RENDERIZAÇÃO
-- ==========================================
_G.SystemViewBotConnection = RunService.RenderStepped:Connect(function()
    local myChar = localPlayer.Character
    local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    
    if not myHRP then return end

    for botEntity, vis in pairs(botCache) do
        if not botEntity or not botEntity.Parent then
            vis.Highlight:Destroy()
            vis.UI:Destroy()
            botCache[botEntity] = nil
            continue
        end

        local targetPart = botEntity:IsA("BasePart") and botEntity
            or botEntity:FindFirstChild("Head") 
            or botEntity:FindFirstChild("HumanoidRootPart") 
            or botEntity.PrimaryPart 
            or botEntity:FindFirstChildWhichIsA("BasePart")
            
        local hum = botEntity:FindFirstChildOfClass("Humanoid") or (botEntity.Parent and botEntity.Parent:FindFirstChildOfClass("Humanoid"))
        local isAlive = hum and (hum.Health > 0) or (not hum)
        
        if targetPart and isAlive then
            local dist = (myHRP.Position - targetPart.Position).Magnitude
            
            if dist <= MAX_DISTANCE then
                local fade = math.clamp((dist - FADE_START) / (MAX_DISTANCE - FADE_START), 0, 1)
                
                vis.Highlight.Parent = botEntity
                vis.Highlight.OutlineTransparency = fade
                
                vis.UI.Adornee = targetPart
                vis.UI.Enabled = true
                
                vis.NameLabel.TextStrokeTransparency = fade
                vis.StatsLabel.TextStrokeTransparency = fade
                vis.NameLabel.TextTransparency = fade
                vis.StatsLabel.TextTransparency = fade
                
                local hpText = hum and math.floor(hum.Health) or "100"
                
                vis.NameLabel.Text = string.format('<font color="%s">🐍 %s</font>', BOT_NAME_COLOR, string.upper(vis.CleanName))
                vis.StatsLabel.Text = string.format('<font color="%s">📍 %dm</font>  |  <font color="%s">💖 %s</font>', DIST_COLOR, math.floor(dist), HP_COLOR, tostring(hpText))
            else
                vis.Highlight.Parent = nil
                vis.UI.Enabled = false
            end
        else
            vis.Highlight.Parent = nil
            vis.UI.Enabled = false
        end
    end
end)

