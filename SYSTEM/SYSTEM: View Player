local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

-- ==========================================
-- 🎈 SYSTEM VIEW PLAYER (TOONS UNIVERSE) 🎈
-- ==========================================

-- SISTEMA DE TOGGLE (LIGA / DESLIGA)
if _G.SystemViewPlayerConnection then
    _G.SystemViewPlayerConnection:Disconnect()
    _G.SystemViewPlayerConnection = nil
    
    if _G.PlayerCacheViewPlayer then
        for _, visualData in pairs(_G.PlayerCacheViewPlayer) do
            if visualData.Highlight then visualData.Highlight:Destroy() end
            if visualData.UI then visualData.UI:Destroy() end
        end
        table.clear(_G.PlayerCacheViewPlayer)
    end
    
    if _G.SystemViewPlayerFolder then
        _G.SystemViewPlayerFolder:Destroy()
        _G.SystemViewPlayerFolder = nil
    end
    
    print("✨ [TOONS] View Player: DESATIVADO E LIMPO")
    return
end

print("✨ [TOONS] View Player: ATIVADO")

-- ==========================================
-- CONFIGURAÇÕES VISUAIS & CORES
-- ==========================================
local MAX_DISTANCE = 500
local FADE_START = 350
local LOW_HEALTH_THRESHOLD = 25 -- Porcentagem para o efeito de alerta

-- Cores Temáticas Toons Universe
local COLOR_FRIEND = "#FFD264"      -- Amarelo Pastel (Amigos)
local COLOR_PLAYER = "#FFFFFF"      -- Branco Puro
local COLOR_DEAD = "#9696A0"        -- Cinza Opaco
local COLOR_DIST = "#78C8FF"        -- Azul Pastel
local COLOR_HP = "#50E68C"          -- Verde Menta
local COLOR_LOW_HP = "#FF6482"      -- Rosa Chiclete / Alerta
local STROKE_COLOR = Color3.fromRGB(20, 15, 45) -- Roxo Escuro Contorno

_G.SystemViewPlayerFolder = Instance.new("Folder")
_G.SystemViewPlayerFolder.Name = "ViewPlayerCache_Toons"
_G.SystemViewPlayerFolder.Parent = localPlayer:WaitForChild("PlayerGui")

_G.PlayerCacheViewPlayer = {}
local localCache = _G.PlayerCacheViewPlayer

-- ==========================================
-- ESTRUTURA VISUAL DA INTERFACE
-- ==========================================
local function createVisuals()
    local data = {}
    
    -- Contorno Mágico (Highlight)
    local hl = Instance.new("Highlight")
    hl.Name = "PlayerOutline"
    hl.FillColor = Color3.fromRGB(120, 200, 255)
    hl.FillTransparency = 0.85
    hl.OutlineColor = Color3.fromRGB(255, 120, 220)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    -- Placa Flutuante (BillboardGui)
    local bg = Instance.new("BillboardGui")
    bg.Name = "PlayerInfoUI"
    bg.Size = UDim2.new(0, 220, 0, 55)
    bg.StudsOffset = Vector3.new(0, 3.5, 0)
    bg.AlwaysOnTop = true
    bg.LightInfluence = 0
    bg.Parent = _G.SystemViewPlayerFolder
    
    -- Rótulo do Nome do Player
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.FredokaOne
    nameLabel.TextSize = 16
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = STROKE_COLOR
    nameLabel.RichText = true
    nameLabel.Parent = bg
    
    -- Rótulo das Estatísticas (Distância + Vida)
    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, 0, 0.5, 0)
    statsLabel.Position = UDim2.new(0, 0, 0.5, 0)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Font = Enum.Font.FredokaOne
    statsLabel.TextSize = 14
    statsLabel.TextStrokeTransparency = 0.1
    statsLabel.TextStrokeColor3 = STROKE_COLOR
    statsLabel.RichText = true
    statsLabel.Parent = bg
    
    data.Highlight = hl
    data.UI = bg
    data.NameLabel = nameLabel
    data.StatsLabel = statsLabel
    
    return data
end

-- ==========================================
-- LOOP DE ATUALIZAÇÃO (RENDER STEPPED)
-- ==========================================
_G.SystemViewPlayerConnection = RunService.RenderStepped:Connect(function()
    local myChar = localPlayer.Character
    local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    
    if not myHRP then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
        
        if char and hum and root then
            local dist = (myHRP.Position - root.Position).Magnitude
            
            if dist <= MAX_DISTANCE then
                if not localCache[p] then localCache[p] = createVisuals() end
                local vis = localCache[p]
                
                -- Lógica de Estado de Vida
                local isDead = hum.Health <= 0
                local isLowHealth = not isDead and (hum.Health < (hum.MaxHealth * (LOW_HEALTH_THRESHOLD / 100)))
                
                -- Cores de Exibição
                local hpColorHex = isDead and COLOR_DEAD or (isLowHealth and ((math.sin(tick() * 10) > 0) and "#FFFFFF" or COLOR_LOW_HP) or COLOR_HP)
                local isFriend = p:IsFriendsWith(localPlayer.UserId)
                local nameColorHex = isDead and COLOR_DEAD or (isFriend and COLOR_FRIEND or COLOR_PLAYER)
                
                -- Opacidade por Distância
                local fade = math.clamp((dist - FADE_START) / (MAX_DISTANCE - FADE_START), 0, 1)
                local transparency = isDead and 0.5 or fade
                
                -- Atualização do Highlight
                vis.Highlight.Parent = char
                vis.Highlight.OutlineTransparency = transparency
                vis.Highlight.OutlineColor = isDead and Color3.fromHex(COLOR_DEAD) or (isFriend and Color3.fromHex(COLOR_FRIEND) or Color3.fromRGB(255, 120, 220))
                
                -- Atualização do BillboardGui
                vis.UI.Adornee = char:FindFirstChild("Head") or root
                vis.UI.Enabled = true
                
                -- Texto e Ícones
                local icon = isDead and "💀" or (isFriend and "⭐" or "👤")
                
                vis.NameLabel.Text = string.format('<font color="%s">%s %s</font>', nameColorHex, icon, p.DisplayName)
                vis.StatsLabel.Text = string.format('<font color="%s">📍 %dm</font>  |  <font color="%s">💖 %d</font>', 
                    isDead and COLOR_DEAD or COLOR_DIST, 
                    math.floor(dist), 
                    hpColorHex, 
                    math.max(0, math.floor(hum.Health))
                )
                
                vis.NameLabel.TextTransparency = transparency
                vis.StatsLabel.TextTransparency = transparency
                vis.NameLabel.TextStrokeTransparency = transparency
                vis.StatsLabel.TextStrokeTransparency = transparency
            else
                if localCache[p] then
                    localCache[p].UI.Enabled = false
                    localCache[p].Highlight.Parent = nil
                end
            end
        else
            if localCache[p] then
                localCache[p].UI.Enabled = false
                localCache[p].Highlight.Parent = nil
            end
        end
    end
end)

-- Limpeza de memória se o jogador sair do servidor
Players.PlayerRemoving:Connect(function(p)
    if localCache[p] then
        if localCache[p].Highlight then localCache[p].Highlight:Destroy() end
        if localCache[p].UI then localCache[p].UI:Destroy() end
        localCache[p] = nil
    end
end)

