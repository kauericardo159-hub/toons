-- 6. ANIMAÇÃO DE ENTRADA (Cartoon Back Out)
local function animateEntry()
    miniPainel.Position = UDim2.new(1.2, 0, 0, 0)
    miniPainel.BackgroundTransparency = 1
    
    task.wait(0.2)
    TweenService:Create(miniPainel, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 0.1
    }):Play()
end

-- Rotação Contínua da Borda Mágica
task.spawn(function()
    while miniPainel.Parent do
        local tween = TweenService:Create(strokeGradient, TweenInfo.new(5, Enum.EasingStyle.Linear), {Rotation = 405})
        tween:Play()
        tween.Completed:Wait()
        strokeGradient.Rotation = 45
    end
end)

animateEntry()
print("✨ MiniPanel View Player & Bot Toons carregado!")
