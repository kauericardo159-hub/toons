-- 2. FUNÇÃO DE DETECÇÃO DE NPC/BOT
local function GetDetectedBots()
    local detectedBots = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            local isRealPlayer = Players:GetPlayerFromCharacter(obj)
            
            if not isRealPlayer then
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                if humanoid.Health > 0 and (obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")) then
                    table.insert(detectedBots, obj)
                end
            end
        end
    end
    
    return detectedBots
end

_G.GetDetectedBots = GetDetectedBots

