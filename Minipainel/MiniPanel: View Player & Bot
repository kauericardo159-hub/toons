-- 4. CRIAÇÃO DOS TOGGLES ESTILIZADOS
local activeStates = {}

local function CreateToggle(name, labelText, posX, loadstringUrl)
    local container = Instance.new("Frame")
    container.Name = name .. "Container"
    container.Size = UDim2.new(0.45, 0, 0, 60)
    container.Position = UDim2.new(posX, 0, 0.62, 0)
    container.AnchorPoint = Vector2.new(0.5, 0.5)
    container.BackgroundTransparency = 1
    container.ZIndex = miniPainel.ZIndex + 1
    container.Parent = miniPainel

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(1, 0, 0, 20)
    iconLabel.Text = labelText
    iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconLabel.Font = Enum.Font.FredokaOne
    iconLabel.TextSize = 14
    iconLabel.BackgroundTransparency = 1
    iconLabel.ZIndex = miniPainel.ZIndex + 2
    iconLabel.Parent = container

    local iconStroke = Instance.new("UIStroke")
    iconStroke.Thickness = 1.5
    iconStroke.Color = Color3.fromRGB(20, 15, 45)
    iconStroke.Parent = iconLabel

    -- Cores dos Toggles (Inativo: Vermelho Pastel / Ativo: Verde Menta Pastel)
    local colorInactiveBase = Color3.fromRGB(70, 30, 45)
    local colorInactiveStroke = Color3.fromRGB(220, 80, 100)
    local colorActiveBase = Color3.fromRGB(30, 75, 55)
    local colorActiveStroke = Color3.fromRGB(100, 220, 150)

    local btnBase = Instance.new("TextButton")
    btnBase.Size = UDim2.new(0, 54, 0, 26)
    btnBase.Position = UDim2.new(0.5, 0, 0.75, 0)
    btnBase.AnchorPoint = Vector2.new(0.5, 0.5)
    btnBase.BackgroundColor3 = colorInactiveBase
    btnBase.Text = ""
    btnBase.AutoButtonColor = false
    btnBase.ZIndex = miniPainel.ZIndex + 2
    btnBase.Parent = container

    Instance.new("UICorner", btnBase).CornerRadius = UDim.new(1, 0)
    
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 2
    btnStroke.Color = colorInactiveStroke
    btnStroke.Parent = btnBase

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = UDim2.new(0.1, 0, 0.5, 0)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.ZIndex = btnBase.ZIndex + 1
    knob.Parent = btnBase
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    activeStates[name] = false

    btnBase.MouseButton1Click:Connect(function()
        activeStates[name] = not activeStates[name]
        local isActive = activeStates[name]

        if _G.NotifyElite then
            local botCount = isActive and name == "BotView" and (" (" .. #GetDetectedBots() .. " detectados)") or ""
            _G.NotifyElite("VISUALIZADOR", labelText .. " " .. (isActive and "ATIVADO" or "DESATIVADO") .. botCount .. "!", isActive)
        end

        local targetPos = isActive and UDim2.new(0.9, -20, 0.5, 0) or UDim2.new(0.1, 0, 0.5, 0)
        
        -- Animações com física Toon (Pop/Elastic)
        TweenService:Create(knob, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = targetPos}):Play()
        TweenService:Create(btnBase, TweenInfo.new(0.3), {BackgroundColor3 = isActive and colorActiveBase or colorInactiveBase}):Play()
        TweenService:Create(btnStroke, TweenInfo.new(0.3), {Color = isActive and colorActiveStroke or colorInactiveStroke}):Play()

        _G[name .. "State"] = isActive

        task.spawn(function()
            local success, err = pcall(function()
                loadstring(game:HttpGet(loadstringUrl))()
            end)
            if not success then
                warn("Erro ao carregar módulo " .. name .. ": " .. tostring(err))
            end
        end)
    end)
end

